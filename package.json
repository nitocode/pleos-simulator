{
  "name": "pleos-simulator",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Simulateur web d'interfaces d'infodivertissement automobile. Première interface : Hyundai Pleos Connect (Ioniq 3).",
  "scripts": {
